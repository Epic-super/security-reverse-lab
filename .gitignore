# 逆向样本与产物（体积大，不入库）
*.exe
*.dll
*.so
*.apk
*.ipa
*.bin
*.dat
*.dump
*.dmp
*.raw
*.img
*.iso

# 但保留哈希与脚本
!artifacts/**/*_hash.txt
!artifacts/**/*.py
!artifacts/**/*.js
!artifacts/**/*.sh

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# IDE
.vscode/
.idea/
*.swp

# OS
Thumbs.db
desktop.ini
.DS_Store

# 本地私密文件
*.local.md
.env
.env.*
secrets/
*.key
*.pem
!artifacts/**/README.md

# 案例脚本的本地目标配置（含真实 IP/端口，绝不入库）
target.local.json

# 大文件（用 Git LFS）
*.psd
*.mp4
*.zip
*.rar
*.7z
